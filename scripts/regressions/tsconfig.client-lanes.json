{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "declaration": false,
    "declarationMap": false,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "typeRoots": [
      "../../node_modules/@types",
      "../../packages/server/node_modules/@types",
      "../../packages/client/node_modules"
    ],
    "paths": {
      "@marinara-engine/shared": [
        "../../packages/shared/src/index.ts"
      ]
    }
  },
  "include": [
    "tts-safari-play-guard.regression.ts",
    "client-runtime-diagnostics.regression.ts",
    "nanogpt-usage-meter-gate.regression.ts",
    "onboarding-preview-highlight.regression.ts",
    "state-editor.regression.ts",
    "marinara-host-namespace.regression.ts"
  ]
}
